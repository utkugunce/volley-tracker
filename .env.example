# Admin Yetkilendirme Belirteci (Token)
# fixtures/upload ve admin/override endpoint'leri için zorunludur.
# Güçlü ve rastgele bir token üretmek için: openssl rand -hex 32
ADMIN_TOKEN=

# Supabase (server-side data persistence; service role key must never be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob Read/Write Token (Serverless ortamda manuel override & bildirim abonelikleri için)
BLOB_READ_WRITE_TOKEN=

# Web Push VAPID Anahtarları (Arka plan maç hatırlatma bildirimleri için)
# npx web-push generate-vapid-keys komutuyla üretilebilir
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@altyapivoleybol.com.tr

# Push abonelikleri için AYRI ve PRIVATE bir Vercel Blob store'unun read/write token'ı (opsiyonel).
# Supabase yapılandırılmamışsa abonelikler bu private store'da abonelik başına ayrı nesne olarak tutulur.
# Tanımlı değilse Blob fallback'i kullanılmaz (abonelikler asla public store'a yazılmaz).
# Oluşturmak için: vercel blob create-store push-subscriptions --access private
PUSH_SUBSCRIPTIONS_BLOB_TOKEN=

# Dağıtık rate limiting (opsiyonel, önerilir): Upstash Redis REST bilgileri.
# İkisi de tanımlıysa limitler tüm serverless örnekleri arasında paylaşılır;
# tanımlı değilse örnek başına bellek içi limit kullanılır.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /api/fixtures?refresh=1 ve /api/kadinlar-2-ligi?refresh=1 üretimde scrape-sync.yml workflow'unu tetikler
# (actions:write yetkili token). Yerel Python scraper yalnızca NODE_ENV=development iken çalıştırılır.
GITHUB_TOKEN=
GITHUB_REPOSITORY=utkugunce/volley-tracker
