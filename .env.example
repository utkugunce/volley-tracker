# Admin Yetkilendirme Belirteci (Token)
# fixtures/upload ve admin/override endpoint'leri için zorunludur.
# Güçlü ve rastgele bir token üretmek için: openssl rand -hex 32
ADMIN_TOKEN=

# Supabase (server-side data persistence; service role key must never be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob Read/Write Token (Serverless ortamda manuel override & bildirim abonelikleri için)
BLOB_READ_WRITE_TOKEN=

# Web Push VAPID Anahtarları (Arka plan maç hatırlatma bildirimleri için)
# npx web-push generate-vapid-keys komutuyla üretilebilir
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@altyapivoleybol.com.tr
