{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "ignoreCommand": "bash vercel-ignore-build.sh",
  "redirects": [
    {
      "source": "/_next/image",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "^/(?<path>[^/\\\\].*)$"
        }
      ],
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/_vercel/image",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "^/(?<path>[^/\\\\].*)$"
        }
      ],
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/_next/image",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/_vercel/image",
      "destination": "/",
      "permanent": false
    }
  ]
}
